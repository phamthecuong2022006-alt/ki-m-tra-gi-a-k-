@model DishCategory_BIT240049
@{
    ViewData["Title"] = L["EditCategory"].Value;
}

<h1 class="h3 mb-3">@L["EditCategory"]</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" style="max-width: 640px">
    <partial name="_ModelErrors" />
    <partial name="_CategoryFields" />
    <button type="submit" class="btn btn-primary">@L["Save"]</button>
    <a class="btn btn-secondary" asp-action="Index">@L["Cancel"]</a>
</form>
