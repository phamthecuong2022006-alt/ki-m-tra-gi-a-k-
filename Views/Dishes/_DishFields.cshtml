@model Dish_BIT240049

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="DishCategoryId" class="form-label"></label>
    <select asp-for="DishCategoryId" class="form-select" asp-items="(SelectList)ViewBag.Categories">
        <option value="0">@L["SelectCategory"]</option>
    </select>
    <span asp-validation-for="DishCategoryId" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" type="number" step="any" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="PreparationTime" class="form-label"></label>
        <input asp-for="PreparationTime" type="number" step="1" class="form-control" />
        <span asp-validation-for="PreparationTime" class="text-danger"></span>
    </div>
</div>

<div class="form-check mb-3">
    <input asp-for="IsAvailable" class="form-check-input" />
    <label asp-for="IsAvailable" class="form-check-label"></label>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>
