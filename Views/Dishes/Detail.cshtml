@model Dish_BIT240049
@{
    ViewData["Title"] = Model.Name;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@Model.Name</h1>
    <div>
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">@L["Edit"]</a>
        <a class="btn btn-secondary" asp-action="Index">@L["BackToList"]</a>
    </div>
</div>

<dl class="row">
    <dt class="col-sm-3">@L["Category"]</dt>
    <dd class="col-sm-9">@Model.DishCategory?.Name</dd>

    <dt class="col-sm-3">@L["Price"]</dt>
    <dd class="col-sm-9">@Model.Price.ToString("N0", CultureInfo.CurrentUICulture) ₫</dd>

    <dt class="col-sm-3">@L["PreparationTime"]</dt>
    <dd class="col-sm-9">
        @Model.PreparationTime @L["Minutes"]
        @if (Model.PreparationTime <= 15)
        {
            <span class="badge text-bg-info ms-1">@L["Quick"]</span>
        }
        else
        {
            <span class="badge text-bg-warning ms-1">@L["Regular"]</span>
        }
    </dd>

    <dt class="col-sm-3">@L["Status"]</dt>
    <dd class="col-sm-9">
        @if (Model.IsAvailable)
        {
            <span class="badge text-bg-success">@L["StatusAvailable"]</span>
        }
        else
        {
            <span class="badge text-bg-secondary">@L["StatusUnavailable"]</span>
        }
    </dd>

    <dt class="col-sm-3">@L["Description"]</dt>
    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</dd>
</dl>

<hr />
<h2 class="h4 mb-3">@L["Images"]</h2>

@if (!Model.Images.Any())
{
    <div class="alert alert-info">@L["NoImagesYet"]</div>
}
else
{
    <div class="row g-3 mb-4">
        @foreach (var img in Model.Images)
        {
            <div class="col-sm-6 col-md-4">
                <div class="card h-100 @(img.IsThumbnail ? "border-primary" : "")">
                    <img class="gallery-img card-img-top" src="@img.ImageUrl" alt="@Model.Name" />
                    <div class="card-body d-flex flex-column gap-2">
                        @if (img.IsThumbnail)
                        {
                            <span class="badge text-bg-primary align-self-start">@L["CurrentThumbnail"]</span>
                        }
                        <div class="mt-auto d-flex gap-2">
                            @if (!img.IsThumbnail)
                            {
                                <form asp-action="SetThumbnail" asp-route-id="@img.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-primary">@L["SetThumbnail"]</button>
                                </form>
                            }
                            <form asp-action="DeleteImage" asp-route-id="@img.Id" method="post"
                                  data-confirm="@L["ConfirmDelete"]">
                                <button type="submit" class="btn btn-sm btn-outline-danger">@L["DeleteImage"]</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="card card-body" style="max-width: 640px">
    <h3 class="h5">@L["AddImage"]</h3>
    <form asp-action="AddImage" asp-route-id="@Model.Id" method="post">
        <div class="mb-3">
            <label class="form-label" for="imageUrl">@L["ImageUrl"]</label>
            <input id="imageUrl" name="imageUrl" type="text" class="form-control" placeholder="https://..." />
        </div>
        <div class="form-check mb-3">
            <input id="isThumbnail" name="isThumbnail" type="checkbox" value="true" class="form-check-input" />
            <label class="form-check-label" for="isThumbnail">@L["IsThumbnail"]</label>
        </div>
        <button type="submit" class="btn btn-primary">@L["AddImage"]</button>
    </form>
</div>
