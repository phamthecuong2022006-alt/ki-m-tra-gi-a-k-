@model string
@{
    ViewData["Title"] = L["NotFoundTitle"].Value;
}
<div class="text-center py-5">
    <h1 class="display-4">404</h1>
    <h2 class="h4">@L["NotFoundTitle"]</h2>
    <p class="text-muted">@L[Model]</p>
    <a class="btn btn-primary" asp-controller="Dishes" asp-action="Index">@L["BackToList"]</a>
</div>
