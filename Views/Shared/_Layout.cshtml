@{
    var ui = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    // Gom ca query string de khi doi ngon ngu van giu nguyen dieu kien tim kiem / loc / sap xep
    var returnUrl = Context.Request.Path.Add(Context.Request.QueryString);
}
<!DOCTYPE html>
<html lang="@ui" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - @L["AppTitle"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-dark bg-dark mb-4">
        <div class="container d-flex flex-wrap align-items-center gap-3">
            <a class="navbar-brand" asp-controller="Dishes" asp-action="Index">@L["AppTitle"]</a>
            <div class="me-auto d-flex gap-3">
                <a class="nav-link text-light" asp-controller="Dishes" asp-action="Index">@L["NavDishes"]</a>
                <a class="nav-link text-light" asp-controller="DishCategories" asp-action="Index">@L["NavCategories"]</a>
            </div>
            <div class="btn-group btn-group-sm" role="group" aria-label="@L["Language"]">
                <a class="btn @(ui == "en" ? "btn-light" : "btn-outline-light")"
                   asp-controller="Home" asp-action="SetLanguage"
                   asp-route-culture="en" asp-route-returnUrl="@returnUrl">English</a>
                <a class="btn @(ui == "vi" ? "btn-light" : "btn-outline-light")"
                   asp-controller="Home" asp-action="SetLanguage"
                   asp-route-culture="vi" asp-route-returnUrl="@returnUrl">Tiếng Việt</a>
            </div>
        </div>
    </nav>

    <main class="container pb-5">
        @if (TempData["Success"] is string successMessage)
        {
            <div class="alert alert-success">@successMessage</div>
        }
        @if (TempData["Error"] is string errorMessage)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }
        @RenderBody()
    </main>

    <footer class="text-center text-muted small pb-4">BIT240049 &middot; @L["AppTitle"]</footer>

    <script src="~/js/site.js"></script>
</body>
</html>
