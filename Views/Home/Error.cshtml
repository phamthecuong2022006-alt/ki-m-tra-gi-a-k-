@{
    ViewData["Title"] = L["ErrorTitle"].Value;
}
<div class="text-center py-5">
    <h1 class="display-4">@Context.Response.StatusCode</h1>
    <h2 class="h4">@L["ErrorTitle"]</h2>
    <p class="text-muted">@L["ErrorMessage"]</p>
    <a class="btn btn-primary" asp-controller="Dishes" asp-action="Index">@L["BackToList"]</a>
</div>
